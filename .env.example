# SIERA Frontend Environment Variables
# =====================================
# This file documents all required environment variables for the SIERA frontend.
# Copy this file to `.env` and fill in the values as needed.
#
# Note: This is a mock/demo frontend without backend integration.
# Most variables are placeholders for future production use.

# ===========================================
# Application Configuration
# ===========================================

# Application title displayed in browser tab
VITE_APP_TITLE=SIERA - PATRIBERA 2025

# API base URL (placeholder for future backend integration)
# Currently not used as this is a mock/demo frontend
VITE_API_URL=http://localhost:3001/api

# ===========================================
# Feature Flags
# ===========================================

# Enable development features (set to 'true' in development)
VITE_ENABLE_DEV_FEATURES=true

# Enable mock data mode (set to 'true' for demo without backend)
VITE_USE_MOCK_DATA=true

# ===========================================
# Analytics & Monitoring (Optional)
# ===========================================

# Google Analytics tracking ID (optional)
# VITE_GA_TRACKING_ID=UA-XXXXXXXXX-X

# Sentry DSN for error tracking (optional)
# VITE_SENTRY_DSN=https://xxx@sentry.io/xxx

# ===========================================
# Development Settings
# ===========================================

# Environment mode (development, staging, production)
VITE_ENV=development

# Enable verbose logging in console
VITE_DEBUG_MODE=true
